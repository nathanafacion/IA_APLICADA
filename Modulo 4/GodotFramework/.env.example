# ── Provedor de LLM ──────────────────────────────────────────────
# Escolha um: ollama | openai
# Sem LLM_PROVIDER configurado → roda em modo mock (sem API)

LLM_PROVIDER=ollama

# ── Ollama (local) ────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# ── OpenAI ────────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
